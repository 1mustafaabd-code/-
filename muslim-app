        }).catch(e => {
            alert("خطأ في الاتصال بالإذاعة، يرجى التحقق من الإنترنت");
            btn.innerHTML = '<i class="fas fa-play"></i>';
        });
    } else {
        radioAudio.pause();
        btn.innerHTML = '<i class="fas fa-play"></i>';
        vis.classList.remove('playing');
        badge.classList.remove('active');
    }
}

function switchStation(station, element) {
    state.currentStation = station;
    
    // Update UI
    document.querySelectorAll('.station-chip').forEach(el => el.classList.remove('active'));
    element.classList.add('active');
    
    document.getElementById('radioStationName').innerText = station === 'cairo' ? "إذاعة القرآن - القاهرة" : "إذاعة القرآن - مكة";

    // If playing, switch stream
    if (!radioAudio.paused) {
        radioAudio.pause();
        toggleRadio(); // Restart with new URL
    }
}


/* --- بقية الوظائف --- */
function setDailyInspiration() {
    const idx = Math.floor(Math.random() * INSPIRATIONS.length);
    document.getElementById('dailyInspiration').innerText = INSPIRATIONS[idx].t;
    document.getElementById('inspirationSource').innerText = INSPIRATIONS[idx].s;
}

function renderNames() {
    const grid = document.getElementById('asmaGrid');
    NAMES_OF_ALLAH.forEach(item => {
        const div = document.createElement('div');
        div.className = 'name-card';
        div.innerHTML = `<div class="allah-name">${item.n}</div>`;
        div.onclick = () => showNameMeaning(item.n, item.m);
        grid.appendChild(div);
    });
}
function showNameMeaning(name, meaning) {
    document.getElementById('modalTitle').innerText = name;
    document.getElementById('modalText').innerText = meaning;
    document.getElementById('zekrControls').style.display = 'none'; 
    document.getElementById('azkarModal').classList.add('active');
}

function renderQada() {
    const list = document.getElementById('qadaList');
    list.innerHTML = "";
    const names = {fajr:"الفجر", dhuhr:"الظهر", asr:"العصر", maghrib:"المغرب", isha:"العشاء"};
    Object.keys(names).forEach(key => {
        const row = document.createElement('div');
        row.className = 'qada-row';
        row.innerHTML = `<div style="font-weight:bold">${names[key]}</div><div class="qada-controls"><button class="qada-btn qada-minus" onclick="changeQada('${key}', -1)">-</button><span class="qada-count">${state.qada[key]}</span><button class="qada-btn qada-plus" onclick="changeQada('${key}', 1)">+</button></div>`;
        list.appendChild(row);
    });
}
function changeQada(key, delta) {
    if(state.qada[key] + delta < 0) return;
    state.qada[key] += delta;
    localStorage.setItem('qada', JSON.stringify(state.qada));
    renderQada();
}

/* --- الصوتيات (القرآن) --- */
function formatTime(seconds) {
    if(isNaN(seconds)) return "0:00";
    const min = Math.floor(seconds / 60);
    const sec = Math.floor(seconds % 60);
    return `${min}:${String(sec).padStart(2, '0')}`;
}
audio.addEventListener('loadedmetadata', () => {
    document.getElementById('durationTime').innerText = formatTime(audio.duration);
    document.getElementById('seekBar').max = audio.duration;
});
audio.addEventListener('timeupdate', () => {
    document.getElementById('currentTime').innerText = formatTime(audio.currentTime);
    document.getElementById('seekBar').value = audio.currentTime;
    if (audio.currentTime >= audio.duration && audio.duration > 0) playNext();
});
audio.addEventListener('ended', playNext);
document.getElementById('seekBar').addEventListener('input', (e) => { audio.currentTime = e.target.value; });
function seekAudio(s) { audio.currentTime = Math.min(audio.duration, Math.max(0, audio.currentTime + s)); }

function playSurah(index) {
  // Stop Radio if playing
  if (!radioAudio.paused) toggleRadio();

  state.currentIndex = index;
  document.getElementById('playerBar').style.display = 'flex';
  document.getElementById('playerTitle').innerText = `سورة ${SURAHS[index]}`;
  document.getElementById('playerReciter').innerText = RECITERS[state.reciter].name;
  document.getElementById('playPauseBtn').innerHTML = '⌛';
  const numStr = String(index + 1).padStart(3, '0');
  audio.src = `${RECITERS[state.reciter].url}${numStr}.mp3`;
  audio.play().then(() => document.getElementById('playPauseBtn').innerHTML = '⏸')
      .catch(e => document.getElementById('playPauseBtn').innerHTML = '▶');
}
function playNext() {
    let nextIndex = state.currentIndex + 1;
    if (nextIndex >= SURAHS.length) nextIndex = 0;
    playSurah(nextIndex);
}
function playPrevious() {
    let prevIndex = state.currentIndex - 1;
    if (prevIndex < 0) prevIndex = SURAHS.length - 1;
    playSurah(prevIndex);
}
function toggleAudio() {
  if (audio.paused) { 
      if (!radioAudio.paused) toggleRadio(); // Stop Radio first
      audio.play(); 
      document.getElementById('playPauseBtn').innerText = '⏸'; 
  } 
  else { audio.pause(); document.getElementById('playPauseBtn').innerText = '▶'; }
}
function stopAudio() {
  audio.pause(); audio.currentTime = 0; state.currentIndex = -1;
  document.getElementById('playerBar').style.display = 'none';
  // Note: Radio stop is handled separately in toggleRadio logic or manual click
}

function initContent() {
  const qList = document.getElementById('surahList');
  const search = document.getElementById('searchSurah');
  document.getElementById('currentReciterName').innerText = RECITERS[state.reciter].name;
  document.getElementById('reciterSelect').value = state.reciter;
  function renderQuran(filter = "") {
    qList.innerHTML = "";
    SURAHS.forEach((name, index) => {
      if (filter && !name.includes(filter)) return;
      const item = document.createElement('div');
      item.className = 'list-item';
      item.innerHTML = `<div class="list-info"><div class="list-num">${index + 1}</div><div style="font-weight:700">سورة ${name}</div></div><button class="btn-action" onclick="playSurah(${index})">▶</button>`;
      qList.appendChild(item);
    });
  }
  search.addEventListener('input', (e) => renderQuran(e.target.value));
  renderQuran();
  renderNames();
}
function changeReciter() {
  const sel = document.getElementById('reciterSelect').value;
  state.reciter = sel;
  localStorage.setItem('reciter', sel);
  document.getElementById('currentReciterName').innerText = RECITERS[sel].name;
}

function updatePrayerUI() {
  if (typeof adhan === 'undefined') return;
  const coords = new adhan.Coordinates(state.lat, state.lon);
  const date = new Date();
  const params = adhan.CalculationMethod.Egyptian();
  const times = new adhan.PrayerTimes(coords, date, params);
  const hijri = new Intl.DateTimeFormat('ar-TN-u-ca-islamic', {day: 'numeric', month: 'long', year: 'numeric'}).format(date);
  document.getElementById('prayerHijriDate').innerText = hijri;
  document.getElementById('widgetDate').innerText = hijri;
  const names = { fajr: 'الفجر', sunrise: 'الشروق', dhuhr: 'الظهر', asr: 'العصر', maghrib: 'المغرب', isha: 'العشاء' };
  const list = document.getElementById('prayerTimesList');
  list.innerHTML = '';
  let next = times.nextPrayer();
  if (!next || next === 'none') { 
      const tomorrow = new Date(date); tomorrow.setDate(tomorrow.getDate() + 1);
      next = 'fajr'; state.nextPrayerTime = new adhan.PrayerTimes(coords, tomorrow, params).fajr;
  } else { state.nextPrayerTime = times.timeForPrayer(next); }
  ['fajr', 'sunrise', 'dhuhr', 'asr', 'maghrib', 'isha'].forEach(key => {
    const t = times[key];
    const hours = t.getHours() % 12 || 12;
    const minutes = String(t.getMinutes()).padStart(2, '0');
    const ampm = t.getHours() >= 12 ? 'م' : 'ص';
    const row = document.createElement('div');
    row.className = `prayer-row ${(key === next) ? 'highlight' : ''}`;
    row.innerHTML = `<div>${names[key]}</div><div>${hours}:${minutes} ${ampm}</div>`;
    list.appendChild(row);
  });
  document.getElementById('widgetNextName').innerText = `القادمة: ${names[next] || 'الفجر'}`;
  const qibla = adhan.Qibla(coords);
  document.getElementById('qiblaAngleText').innerText = `${Math.round(qibla)}° من الشمال`;
  document.getElementById('qiblaCompass').style.transform = `rotate(${qibla}deg)`;
}
function updateCountdown() {
    if (!state.nextPrayerTime) return;
    const diff = state.nextPrayerTime - new Date();
    if (diff <= 0) { updatePrayerUI(); return; }
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('widgetCountDown').innerText = `-${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}
function getUserLocation() {
  const status = document.getElementById('locStatusSettings');
  status.innerText = "جاري الاتصال...";
  if(!navigator.geolocation) { status.innerText = "غير مدعوم"; return; }
  navigator.geolocation.getCurrentPosition(pos => {
      state.lat = pos.coords.latitude; state.lon = pos.coords.longitude;
      localStorage.setItem('lat', state.lat); localStorage.setItem('lon', state.lon);
      status.innerText = "✅ تم"; document.getElementById('widgetLocation').innerText = "📍 GPS نشط";
      updatePrayerUI();
  }, () => status.innerText = "❌ فشل", { enableHighAccuracy: true });
}

let zekrTarget = 0, zekrCurrent = 0;
function startZekr(title, text, count) {
  document.getElementById('modalTitle').innerText = title;
  document.getElementById('modalText').innerText = text;
  document.getElementById('zekrControls').style.display = 'block'; 
  zekrTarget = count; zekrCurrent = 0;
  updateZekrUI();
  document.getElementById('azkarModal').classList.add('active');
}
function countZekr() {
  if (zekrCurrent < zekrTarget) {
    zekrCurrent++; updateZekrUI(); playClickSound();
    if (zekrCurrent === zekrTarget) setTimeout(closeAzkarModal, 500);
  }
}
function updateZekrUI() {
  document.getElementById('currentCount').innerText = zekrCurrent;
  document.getElementById('targetCount').innerText = zekrTarget;
  document.getElementById('modalBar').style.width = `${(zekrCurrent/zekrTarget)*100}%`;
}
function closeAzkarModal() { document.getElementById('azkarModal').classList.remove('active'); }
function incrementTasbeeh() {
  state.tasbeehCount++; localStorage.setItem('tasbeehCount', state.tasbeehCount);
  document.getElementById('tasbeehCount').innerText = state.tasbeehCount;
  playClickSound();
}
function resetTasbeeh() {
  if(confirm("تصفير؟")) { state.tasbeehCount = 0; localStorage.setItem('tasbeehCount', 0); document.getElementById('tasbeehCount').innerText = 0; }
}
function playClickSound() {
    if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
    if (audioContext.state === 'suspended') audioContext.resume();
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    osc.connect(gain); gain.connect(audioContext.destination);
    osc.frequency.setValueAtTime(600, audioContext.currentTime);
    gain.gain.setValueAtTime(0.05, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.1);
    osc.start(); osc.stop(audioContext.currentTime + 0.1);
}
function initTheme() {
  const btn = document.getElementById('themeBtn');
  const apply = () => {
    if(state.theme === 'dark') { document.body.classList.add('dark'); btn.innerText = '☀️'; } 
    else { document.body.classList.remove('dark'); btn.innerText = '🌙'; }
  };
  btn.addEventListener('click', () => {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', state.theme);
    apply();
  });
  apply();
}

window.addEventListener('DOMContentLoaded', () => {
  initTheme();
  initContent();
  updatePrayerUI();
  setDailyInspiration();
  setInterval(updateCountdown, 1000);
  if(localStorage.getItem('lat')) document.getElementById('widgetLocation').innerText = "📍 GPS محفوظ";
});
</script>
